--- !u!114 &4756016352549656943
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3199198507774575743}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 11ceb95fa082a584f8cd4903fab303a6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  note: "Set our player variable\n\nADD THIS TO HANDITEMTRACKER.CS\r\n\r\nmake public
    touchingobject and heldItem\r\n\n\r\nIEnumerator PerformActionsWithDelay(GameObject
    droppedObject)\r\n{\r\n\r\n    // Wait for 1 seconds\r\n    yield return new
    WaitForSeconds(1f);\r\n    droppedObject.tag = \"XRItem\";\r\n}\r\n\r\npublic
    void DropThatShit()\r\n{\r\n    GameObject theObject = heldItem.gameObject;\r\n   
    theObject.tag = \"Untagged\";\r\n    theObject.GetComponent<Rigidbody>().useGravity
    = true;\r\n    theObject.GetComponent<Rigidbody>().isKinematic = false;\r\n   
    theObject.GetComponent<Rigidbody>().velocity = new Vector3(0, 0, 0);\r\n    touchingObj.Remove(heldItem.GetComponent<Collider>());\r\n   
    holdID = HoldType.None;\r\n    heldItem = null;\r\n    StartCoroutine(PerformActionsWithDelay(theObject));\r\n}\r\n"
